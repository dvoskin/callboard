# Zoho OAuth credentials
# Get these from https://api-console.zoho.com
ZOHO_CLIENT_ID=your_client_id_here
ZOHO_CLIENT_SECRET=your_client_secret_here
ZOHO_REFRESH_TOKEN=your_refresh_token_here

# Region-specific URLs (US is default — change for EU/AU/etc)
ZOHO_BASE_URL=https://www.zohoapis.com
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com

# How many minutes off from scheduled time still counts as "on time" (default 15)
SCHEDULED_TOLERANCE_MINUTES=15
